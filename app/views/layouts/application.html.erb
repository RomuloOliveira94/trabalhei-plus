<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Trabalheiamais" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Trabalheiamais">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white text-gray-900">
    <header class="border-b border-gray-100">
      <div class="container mx-auto flex h-16 items-center justify-between px-5">
        <%= link_to t(".app_name"), root_path, class: "text-xl font-bold text-red-600" %>

        <% if user_signed_in? %>
          <details class="relative" data-turbo="false">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-red-600 text-sm font-bold text-white"><%= current_user.name.first.upcase %></span>
              <span class="hidden sm:inline"><%= current_user.name %></span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="absolute right-0 z-10 mt-2 w-56 rounded-md border border-gray-100 bg-white py-2 text-sm">
              <div class="border-b border-gray-100 px-4 pb-2">
                <p class="font-medium text-gray-900"><%= current_user.name %></p>
                <p class="truncate text-gray-500"><%= current_user.email %></p>
              </div>
              <%= button_to t(".sign_out"), destroy_user_session_path, method: :delete, form_class: "px-2 pt-2", class: "w-full rounded px-2 py-2 text-left font-medium text-red-600 hover:bg-gray-50" %>
            </div>
          </details>
        <% else %>
          <%= link_to t(".sign_in"), new_user_session_path, class: "text-sm font-semibold text-red-600 hover:text-red-700" %>
        <% end %>
      </div>
    </header>

    <% flash.each do |type, message| %>
      <div class="<%= type.to_s == "notice" ? "bg-green-50 text-green-800" : "bg-red-50 text-red-800" %> border-b px-5 py-3 text-sm">
        <div class="container mx-auto"><%= message %></div>
      </div>
    <% end %>

    <main class="container mx-auto mt-8 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
