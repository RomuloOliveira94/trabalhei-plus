<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || t("layouts.application.app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("layouts.application.app_name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#dc2626">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# SEO (Phase 6). Default description/keywords; per-page titles via
        content_for(:title) set through the page_title helper. %>
    <meta name="description" content="<%= t("layouts.application.meta_description") %>">
    <meta name="keywords" content="<%= t("layouts.application.meta_keywords") %>">
    <meta name="robots" content="index, follow">
    <meta property="og:title" content="<%= content_for(:title) || t("layouts.application.app_name") %>">
    <meta property="og:description" content="<%= t("layouts.application.meta_description") %>">
    <meta property="og:image" content="/icon-512.png">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for(:title) || t("layouts.application.app_name") %>">
    <meta name="twitter:description" content="<%= t("layouts.application.meta_description") %>">
    <meta name="twitter:image" content="/icon-512.png">
    <link rel="canonical" href="<%= request.original_url %>">

    <%# PWA (Phase 6): installable app via static manifest + service worker. %>
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="alternate icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/icon.svg">
    <script>
      // Register the service worker only in production-like contexts where
      // HTTPS (or localhost) is guaranteed; skip in plain HTTP dev.
      if ("serviceWorker" in navigator && (location.protocol === "https:" || location.hostname === "localhost" || location.hostname === "127.0.0.1")) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white text-gray-900">
    <%# Accessibility: keyboard users can jump straight to the content. %>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-red-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
      <%= t("layouts.application.skip_to_content") %>
    </a>

    <header class="border-b border-gray-100">
      <div class="container mx-auto flex h-16 items-center justify-between px-5">
        <%= link_to t(".app_name"), root_path, class: "text-xl font-bold text-red-600 transition-colors duration-150 hover:text-red-700" %>

        <% if user_signed_in? %>
          <details class="relative" data-turbo="false">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full px-3 py-2 text-sm font-medium text-gray-700 transition-colors duration-150 hover:bg-gray-50">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-red-600 text-sm font-bold text-white"><%= current_user.name.first.upcase %></span>
              <span class="hidden sm:inline"><%= current_user.name %></span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="absolute right-0 z-10 mt-2 w-56 rounded-md border border-gray-100 bg-white py-2 text-sm">
              <div class="border-b border-gray-100 px-4 pb-2">
                <p class="font-medium text-gray-900"><%= current_user.name %></p>
                <p class="truncate text-gray-500"><%= current_user.email %></p>
              </div>
              <%= link_to t(".my_account"), edit_user_registration_path, class: "mx-2 mt-2 flex min-h-11 items-center rounded px-2 py-2 font-medium text-gray-700 transition-colors duration-150 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-red-200" %>
              <%= button_to t(".sign_out"), destroy_user_session_path, method: :delete, form_class: "px-2 pb-1", class: "flex min-h-11 w-full items-center rounded px-2 py-2 text-left font-medium text-red-600 transition-colors duration-150 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-red-200" %>
            </div>
          </details>
        <% else %>
          <%= link_to t(".sign_in"), new_user_session_path, class: "text-sm font-semibold text-red-600 transition-colors duration-150 hover:text-red-700" %>
        <% end %>
      </div>
    </header>

    <%# id="flash" is the Turbo Stream target for create/update/destroy notices. %>
    <div id="flash">
      <%= render "shared/flash" %>
    </div>

    <main id="main-content" class="container mx-auto mt-8 px-5">
      <%= yield %>
    </main>

    <%= render "shared/confirm_modal" %>
    <%= render "shared/dialog_modal" %>
  </body>
</html>