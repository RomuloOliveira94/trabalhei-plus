<%# Ransack date-range filter. Rendered twice on the index: inside the mobile
    <details> sheet and inline on desktop. Labels are explicit i18n keys, so
    Ransack's own predicate translations are not needed. %>
<%= search_form_for @ransack, url: overtimes_path, html: { class: "flex flex-wrap items-end gap-3" } do |f| %>
  <div>
    <%= f.label :start_at_gteq, t(".filter_from"), class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :start_at_gteq, class: "mt-1 block rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm" %>
  </div>
  <div>
    <%= f.label :start_at_lteq, t(".filter_to"), class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :start_at_lteq, class: "mt-1 block rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm" %>
  </div>
  <%= f.submit t(".filter_submit"), class: "rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
<% end %>