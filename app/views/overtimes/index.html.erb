<div class="w-full">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= t(".title") %></h1>
      <p class="mt-1 text-sm text-gray-500">
        <%= t(".period", from: l(@filter_start_date), to: l(@filter_end_date)) %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%# Download forms carry the active filter as plain from/to params.
          data-turbo="false" is required so Turbo doesn't swallow the
          file-download response. %>
      <%= form_with url: export_overtimes_pdf_path, method: :get, data: { turbo: false } do %>
        <%= hidden_field_tag :from, @filter_start_date %>
        <%= hidden_field_tag :to, @filter_end_date %>
        <%= submit_tag t(".export_pdf"), class: "inline-flex cursor-pointer items-center justify-center rounded-lg border border-red-600 bg-white px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50" %>
      <% end %>
      <%= form_with url: export_overtimes_xlsx_path, method: :get, data: { turbo: false } do %>
        <%= hidden_field_tag :from, @filter_start_date %>
        <%= hidden_field_tag :to, @filter_end_date %>
        <%= submit_tag t(".export_xlsx"), class: "inline-flex cursor-pointer items-center justify-center rounded-lg border border-red-600 bg-white px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50" %>
      <% end %>
      <%# Desktop keeps the in-header button; mobile uses the FAB instead.
          Both open the CRUD modal (dialog-modal) instead of navigating. %>
      <% new_url = new_overtime_path(from: @filter_start_date, to: @filter_end_date) %>
      <%= link_to t(".new_overtime"), new_url,
          data: { dialog_modal_url_value: new_url, dialog_modal_title_value: t("overtimes.new.title") },
          class: "hidden md:inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-700" %>
    </div>
  </div>

  <%= render "summary" %>

  <%# Mobile filter sheet: collapsible <details>; desktop keeps the inline form. %>
  <details id="filter-sheet" class="group mt-6 md:hidden">
    <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-medium text-gray-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
      </svg>
      <%= t(".filter_toggle") %>
      <svg xmlns="http://www.w3.org/2000/svg" class="ml-auto h-4 w-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
      </svg>
    </summary>
    <div class="mt-3 rounded-lg border border-gray-100 bg-gray-50 p-4">
      <%= render "filter_form" %>
    </div>
  </details>

  <div class="mt-6 hidden md:block">
    <%= render "filter_form" %>
  </div>

  <%# The CRUD form lives in the dialog-modal (shared/_dialog_modal), loaded
      on demand via a Turbo Frame; create/update append/replace the list row
      via Turbo Streams (SPEC AC-1/AC-2). No inline frame here anymore. %>

  <% if @overtimes.any? %>
    <%= render "list" %>
  <% else %>
    <%= render "empty_state" %>
  <% end %>

  <%# Mobile FAB (SPEC §8): bottom-right, red, circular, < md only. Opens the
      CRUD modal like the desktop button. %>
  <%= link_to new_url,
      data: { dialog_modal_url_value: new_url, dialog_modal_title_value: t("overtimes.new.title") },
      class: "fixed bottom-6 right-5 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-red-600 text-white shadow-lg hover:bg-red-700 md:hidden",
      aria: { label: t(".new_overtime") } do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
  <% end %>
</div>