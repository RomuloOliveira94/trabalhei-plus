<div class="w-full">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= t(".title") %></h1>
      <p class="mt-1 text-sm text-gray-500">
        <%= t(".period", from: l(@filter_start_date), to: l(@filter_end_date)) %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%# Download forms carry the active filter as plain from/to params.
          data-turbo="false" is required so Turbo doesn't swallow the
          file-download response. %>
      <%= form_with url: export_overtimes_pdf_path, method: :get, data: { turbo: false } do %>
        <%= hidden_field_tag :from, @filter_start_date %>
        <%= hidden_field_tag :to, @filter_end_date %>
        <%= submit_tag t(".export_pdf"), class: "inline-flex cursor-pointer items-center justify-center rounded-lg border border-red-600 bg-white px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50" %>
      <% end %>
      <%= form_with url: export_overtimes_xlsx_path, method: :get, data: { turbo: false } do %>
        <%= hidden_field_tag :from, @filter_start_date %>
        <%= hidden_field_tag :to, @filter_end_date %>
        <%= submit_tag t(".export_xlsx"), class: "inline-flex cursor-pointer items-center justify-center rounded-lg border border-red-600 bg-white px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50" %>
      <% end %>
      <%= link_to t(".new_overtime"), new_overtime_path, class: "inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-700" %>
    </div>
  </div>

  <div class="mt-6 rounded-lg border border-gray-100 bg-gray-50 px-5 py-4">
    <p class="text-sm font-medium text-gray-600"><%= t(".total_hours") %></p>
    <p class="mt-1 text-3xl font-bold text-red-600">
      <%= number_with_precision(@summary, precision: 1, separator: ",", delimiter: ".") %>h
    </p>
  </div>

  <%= search_form_for @ransack, url: overtimes_path, html: { class: "mt-6 flex flex-wrap items-end gap-3" } do |f| %>
    <div>
      <%= f.label :start_at_gteq, t(".filter_from"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :start_at_gteq, class: "mt-1 block rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm" %>
    </div>
    <div>
      <%= f.label :start_at_lteq, t(".filter_to"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :start_at_lteq, class: "mt-1 block rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm" %>
    </div>
    <%= f.submit t(".filter_submit"), class: "rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
  <% end %>

  <% if @overtimes.any? %>
    <%# Desktop pagination navigates this frame; data-turbo-action="advance"
        keeps the URL in sync (Turbo handbook "Promoting a Frame Navigation
        to a Page Visit"). The mobile list lives inside the same frame so
        both breakpoints stay in sync. Row actions opt out with
        data-turbo-frame="_top" (see _overtime_actions) to keep their
        full-page redirects and flash notices. %>
    <%= turbo_frame_tag "overtime_list", data: { turbo_action: "advance" } do %>
      <div class="mt-6 hidden overflow-x-auto rounded-lg border border-gray-100 md:block">
        <table class="min-w-full divide-y divide-gray-100 text-left text-sm">
          <thead class="text-xs font-semibold uppercase tracking-wide text-gray-500">
            <tr>
              <th class="px-4 py-3"><%= t(".column_date") %></th>
              <th class="px-4 py-3"><%= t(".column_start") %></th>
              <th class="px-4 py-3"><%= t(".column_end") %></th>
              <th class="px-4 py-3"><%= t(".column_duration") %></th>
              <th class="px-4 py-3"><%= t(".column_description") %></th>
              <th class="px-4 py-3 text-right"><%= t(".column_actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <%= render @overtimes %>
          </tbody>
        </table>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-6 hidden justify-center md:flex">
          <%= render "pagination", pagy: @pagy %>
        </div>
      <% end %>

      <div id="overtimes-mobile-list" class="mt-6 space-y-3 md:hidden" data-controller="infinite-scroll">
        <%= render partial: "overtime_card", collection: @overtimes, as: :overtime %>
        <%= render "sentinel", pagy: @pagy if @pagy.next %>
      </div>
    <% end %>
  <% else %>
    <div class="mt-6 rounded-lg border border-dashed border-gray-200 px-6 py-12 text-center">
      <p class="text-gray-600"><%= t(".empty") %></p>
      <p class="mt-3">
        <%= link_to t(".empty_cta"), new_overtime_path, class: "font-semibold text-red-600 hover:text-red-700" %>
      </p>
    </div>
  <% end %>
</div>
