<div class="rounded-lg border border-gray-100 p-4">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="font-semibold text-gray-900"><%= l(overtime.start_at, format: :short_date) %></p>
      <p class="mt-0.5 text-sm text-gray-600">
        <%= l(overtime.start_at, format: :hours_minutes) %> – <%= l(overtime.end_at, format: :hours_minutes) %>
      </p>
    </div>
    <span class="inline-flex shrink-0 items-center rounded-full bg-red-50 px-2.5 py-1 text-sm font-semibold text-red-600">
      <%= number_with_precision(overtime.duration_hours_decimal, precision: 1, separator: ",", delimiter: ".") %>h
    </span>
  </div>
  <p class="mt-2 line-clamp-2 text-sm text-gray-600"><%= overtime.description %></p>
  <div class="mt-3 flex justify-end"><%= render "overtime_actions", overtime: overtime %></div>
</div>
