<%# The overtime list frame (table + mobile cards + pagination). Shared by the
    index and by create.turbo_stream.erb when the first record of an empty
    filter replaces the empty state. Requires @overtimes, @pagy and @ransack. %>
<%= turbo_frame_tag "overtime_list", data: { turbo_action: "advance" } do %>
  <div class="mt-6 hidden overflow-x-auto rounded-lg border border-gray-100 md:block">
    <table class="min-w-full divide-y divide-gray-100 text-left text-sm">
      <thead class="text-xs font-semibold uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-3"><%= t("overtimes.index.column_date") %></th>
          <th class="px-4 py-3"><%= t("overtimes.index.column_start") %></th>
          <th class="px-4 py-3"><%= t("overtimes.index.column_end") %></th>
          <th class="px-4 py-3"><%= t("overtimes.index.column_duration") %></th>
          <th class="px-4 py-3"><%= t("overtimes.index.column_description") %></th>
          <th class="px-4 py-3 text-right"><%= t("overtimes.index.column_actions") %></th>
        </tr>
      </thead>
      <tbody id="overtimes-table-body" class="divide-y divide-gray-100">
        <%= render @overtimes %>
      </tbody>
    </table>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="mt-6 hidden justify-center md:flex">
      <%= render "pagination", pagy: @pagy %>
    </div>
  <% end %>

  <div id="overtimes-mobile-list" class="mt-6 space-y-3 md:hidden" data-controller="infinite-scroll">
    <%= render partial: "overtime_card", collection: @overtimes, as: :overtime %>
    <%= render "sentinel", pagy: @pagy if @pagy.next %>
  </div>
<% end %>