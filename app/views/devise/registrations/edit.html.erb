<%# Account settings (Phase 6): same centered card as the other auth pages. %>
<% content_for :auth_tagline, t("devise.registrations.edit.tagline") %>

<%= render "devise/shared/auth_card" do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mt-8 space-y-5">
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: input_classes %>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, autocomplete: "email", class: input_classes %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-sm text-gray-600"><%= t('.currently_waiting_confirmation_for_email', email: resource.unconfirmed_email) %></p>
      <% end %>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
        <p class="mt-1 text-xs text-gray-500"><%= t('.leave_blank_if_you_don_t_want_to_change_it') %></p>
        <%= f.password_field :password, autocomplete: "new-password", class: input_classes %>
        <% if @minimum_password_length %>
          <p class="mt-1 text-xs text-gray-500"><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input_classes %>
      </div>

      <div>
        <%= f.label :current_password, class: "block text-sm font-medium text-gray-700" %>
        <p class="mt-1 text-xs text-gray-500"><%= t('.we_need_your_current_password_to_confirm_your_changes') %></p>
        <%= f.password_field :current_password, autocomplete: "current-password", class: input_classes %>
      </div>

      <div>
        <%= f.submit t('.update'), class: primary_button_classes %>
      </div>
    </div>
  <% end %>

  <div class="mt-8 border-t border-gray-100 pt-6">
    <h3 class="text-sm font-semibold text-gray-900"><%= t('.cancel_my_account') %></h3>
    <p class="mt-1 text-sm text-gray-600"><%= t('.unhappy') %></p>
    <%= button_to t('.cancel_my_account'), registration_path(resource_name),
        data: { confirm: t('.are_you_sure'), turbo_confirm: t('.are_you_sure') },
        method: :delete,
        class: "mt-3 cursor-pointer rounded-lg border border-red-600 bg-white px-4 py-2.5 text-sm font-semibold text-red-600 transition-colors duration-150 hover:bg-red-50" %>
  </div>

  <p class="mt-6 text-center text-sm text-gray-600">
    <%= link_to t('devise.shared.links.back'), :back, class: "font-semibold text-red-600 hover:text-red-700" %>
  </p>
<% end %>