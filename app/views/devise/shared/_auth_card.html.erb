<%# Shared auth card wrapper (Phase 6). Centered card on a light gray
    backdrop, mobile-first (full width on small screens, max-w-md on desktop).
    Used by the sign-in, sign-up and password-reset pages. %>
<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center py-8">
  <div class="w-full max-w-md rounded-xl border border-gray-100 bg-white p-6 shadow-sm sm:p-8">
    <div class="text-center">
      <p class="text-2xl font-bold text-red-600"><%= t("layouts.application.app_name") %></p>
      <p class="mt-2 text-sm text-gray-500"><%= yield(:auth_tagline) %></p>
    </div>
    <%= yield %>
  </div>
</div>