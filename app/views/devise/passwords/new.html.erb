<%# Branded password-reset page (Phase 6), matching the sign-in card. %>
<% content_for :auth_tagline, t(".tagline") %>

<%= render "devise/shared/auth_card" do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mt-8 space-y-5">
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm transition-colors duration-150 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-200" %>
      </div>

      <div>
        <%= f.submit t('devise.passwords.new.send_me_reset_password_instructions'), class: "w-full cursor-pointer rounded-lg bg-red-600 px-4 py-3 text-sm font-semibold text-white transition-colors duration-150 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-200" %>
      </div>
    </div>
  <% end %>

  <p class="mt-6 text-center text-sm text-gray-600">
    <%= link_to t("devise.passwords.new.back_to_sign_in"), new_session_path(resource_name), class: "font-semibold text-red-600 hover:text-red-700" %>
  </p>
<% end %>