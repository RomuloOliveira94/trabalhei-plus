<%# Change password (Phase 6): same centered card as the other auth pages. %>
<% content_for :auth_tagline, t("devise.passwords.edit.tagline") %>

<%= render "devise/shared/auth_card" do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="mt-8 space-y-5">
      <div>
        <%= f.label :password, t('.new_password'), class: "block text-sm font-medium text-gray-700" %>
        <% if @minimum_password_length %>
          <p class="mt-1 text-xs text-gray-500"><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: input_classes %>
      </div>

      <div>
        <%= f.label :password_confirmation, t('.confirm_new_password'), class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input_classes %>
      </div>

      <div>
        <%= f.submit t('.change_my_password'), class: primary_button_classes %>
      </div>
    </div>
  <% end %>

  <p class="mt-6 text-center text-sm text-gray-600">
    <%= link_to t("devise.passwords.new.back_to_sign_in"), new_session_path(resource_name), class: "font-semibold text-red-600 hover:text-red-700" %>
  </p>
<% end %>