<% flash.each do |type, message| %>
  <div data-controller="flash-dismiss"
       data-flash-dismiss-type-value="<%= type %>"
       class="<%= type.to_s == "notice" ? "bg-green-50 text-green-800" : "bg-red-50 text-red-800" %> relative border-b px-5 py-3 text-sm transition-opacity duration-500">
    <div class="container mx-auto flex items-center justify-between gap-4">
      <p class="min-w-0"><%= message %></p>
      <button type="button"
              data-action="flash-dismiss#dismiss"
              aria-label="<%= t("shared.flash.close") %>"
              class="shrink-0 rounded p-1 opacity-60 transition-opacity duration-150 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-current">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
<% end %>