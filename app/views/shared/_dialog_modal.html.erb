<%# Accessible CRUD modal (Phase 5 follow-up): "Nova hora extra" and "Editar"
    open this <dialog> and load the form into the turbo-frame inside it.
    Driven by the dialog-modal Stimulus controller; triggers carry
    data-dialog-modal-url-value and data-dialog-modal-title-value. Rendered
    once in the application layout. %>
<div data-controller="dialog-modal">
  <dialog data-dialog-modal-target="dialog"
          data-action="keydown->dialog-modal#keydown click->dialog-modal#clicked"
          class="m-auto w-full max-w-lg rounded-lg border border-gray-200 bg-white p-0 shadow-xl backdrop:bg-gray-900/50">
    <div class="relative p-6">
      <button type="button" id="dialog-modal-close" data-action="dialog-modal#close"
              class="absolute right-4 top-4 rounded p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-700"
              aria-label="<%= t("components.dialog_modal.close") %>">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div data-dialog-modal-target="body">
        <turbo-frame id="overtime_form"></turbo-frame>
      </div>
    </div>
  </dialog>
</div>