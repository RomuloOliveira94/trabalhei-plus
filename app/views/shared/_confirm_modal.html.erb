<%# Accessible delete-confirmation modal (SPEC §8 "Modal de confirmação de
    delete"). Driven by the confirm-modal Stimulus controller: any element
    with data-confirm opens it, confirming submits the original form/link.
    Rendered once in the application layout; labels come from i18n. %>
<div data-controller="confirm-modal">
  <dialog data-confirm-modal-target="dialog"
          data-default-title="<%= t("components.confirm_modal.title") %>"
          data-default-confirm-label="<%= t("components.confirm_modal.confirm") %>"
          data-default-cancel-label="<%= t("components.confirm_modal.cancel") %>"
          data-action="keydown->confirm-modal#keydown"
          class="m-auto w-full max-w-sm rounded-lg border border-gray-200 bg-white p-0 shadow-xl backdrop:bg-gray-900/50"
          aria-labelledby="confirm-modal-title"
          aria-describedby="confirm-modal-body">
    <div class="p-6">
      <h2 id="confirm-modal-title" data-confirm-modal-target="title" class="text-lg font-semibold text-gray-900"></h2>
      <p id="confirm-modal-body" data-confirm-modal-target="body" class="mt-2 text-sm text-gray-600"></p>
      <div class="mt-6 flex justify-end gap-3">
        <button type="button" data-confirm-modal-target="cancelButton" data-action="confirm-modal#cancel"
                class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors duration-150 hover:bg-gray-50">
          <%= t("components.confirm_modal.cancel") %>
        </button>
        <button type="button" data-confirm-modal-target="confirmButton" data-action="confirm-modal#confirm"
                class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-red-700">
          <%= t("components.confirm_modal.confirm") %>
        </button>
      </div>
    </div>
  </dialog>
</div>